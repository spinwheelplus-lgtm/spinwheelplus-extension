{
  "manifest_version": 3,
  "name": "SpinWheelPlus",
  "version": "1.2.3",
  "description": "Spin a wheel or pick names, numbers, dice, coin, yes/no, shuffle, and teams in Firefox's sidebar. Local and free.",
  "homepage_url": "https://spinwheelplus.com",
  "action": {
    "default_title": "SpinWheelPlus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "sidebar_action": {
    "default_title": "SpinWheelPlus",
    "default_panel": "sidepanel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "open_at_install": false
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "contact@spinwheelplus.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
