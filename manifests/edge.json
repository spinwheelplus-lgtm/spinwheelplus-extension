{
  "manifest_version": 3,
  "name": "SpinWheelPlus",
  "version": "1.2.2",
  "description": "Spin a wheel or pick names, numbers, dice, coin, yes/no, shuffle, and teams in Microsoft Edge's side panel. Local and free.",
  "homepage_url": "https://spinwheelplus.com",
  "action": {
    "default_title": "SpinWheelPlus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage"],
  "offline_enabled": true
}
